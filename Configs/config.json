{
  "name": "ConvNeXtClassifierBackbone",
  "seed": 42,

  "model": {
    "model_type": "ConvNeXtClassifierBackbone",
    "num_classes": 2,
    "pretrained_path": null,
    "freeze_backbone": false
  },
  "optimizer": {
    "optimizer_type": "Adam",
    "lr": 2e-4,
    "weight_decay": 0.001,
    "betas": [0.9, 0.999]
  },
  "trainer": {
    "trainer_type": "LightningTrainer",
    "save_dir": "D:/nnModels/RGDetector",
    "batch_size": 96,
    "epochs": 50,
    "save_every_n_epochs": 5,
    "limit_train_batches": 1.0,
    "limit_val_batches": 1.0,
    "num_workers": 8,
    "persistent_workers": true,
    "log_every_n_steps": 50,
    "check_val_every_n_epoch": 1,
    "accelerator": "cuda",
    "devices": 1,
    "precision": "16-mixed"
  },
  "loss": "cross_entropy",

  "dataset": {
    "img_height": 256,
    "img_width": 256,

    "dataset_type": "BaseDataset",
    "train_class_0_paths": [
      "D:/Datasets/RealAndSyntheticImagesProcessedAfterPillow/RealArt/RealArt/*",
      "D:/Datasets/RealAndSyntheticImagesProcessedAfterPillow/train/real/*",
      "D:/Datasets/RealAndSyntheticImagesProcessedAfterPillow/synthbuster-plus_images/real/train*/*"
    ],
    "train_class_1_paths": [
      "D:/Datasets/RealAndSyntheticImagesProcessedAfterPillow/AiArtData/AiArtData/*",
      "D:/Datasets/RealAndSyntheticImagesProcessedAfterPillow/train/fake/*",
      "D:/Datasets/RealAndSyntheticImagesProcessedAfterPillow/MNW/AI_Images/*/*",
      "D:/Datasets/RealAndSyntheticImagesProcessedAfterPillow/synthbuster-plus_images/generated/train*/*"
    ],

    "val_class_0_paths": [
      "D:/Datasets/RealAndSyntheticImagesProcessedAfterPillow/synthbuster-plus_images/real/validation*/*",
      "D:/Datasets/RealAndSyntheticImagesProcessedAfterPillow/test/real/*"
    ],
    "val_class_1_paths": [
      "D:/Datasets/RealAndSyntheticImagesProcessedAfterPillow/synthbuster-plus_images/generated/validation*/*",
      "D:/Datasets/RealAndSyntheticImagesProcessedAfterPillow/test/fake/*"
    ]
  }
}